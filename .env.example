# Copy to .env (git-ignored) and fill in. Never commit real keys.

# NVIDIA API catalog key used for nvidia/nemotron-3-ultra-550b-a55b (backbones.text_agent)
NVIDIA_API_KEY=
# Optional separate key for nvidia/nemotron-3.5-bolt-e4b (backbones.fast_text); falls back to NVIDIA_API_KEY
NVIDIA_API_KEY_BOLT=

# Optional: only for --t2i dalle3 / evaluation.text2image.backend=dalle3 (the paper's DALL-E 3 setting)
OPENAI_API_KEY=

# Optional: Hugging Face token (higher download rate limits)
HF_TOKEN=
